# 复制本文件到 ~/.autolearn/.env 并填写（也可直接设环境变量）

# ===== 默认目标系统（open_system 不传参时的兜底；建议测试环境）=====
TARGET_URL=http://your-system/

# ===== 全局自动登录凭据（默认系统的 auto_login 兜底凭据）=====
# 多系统凭据推荐用 ~/.autolearn/credentials.json（按系统隔离，立即生效无需重载）：
# {
#   "zfs": {"username": "账号1", "password": "密码1"},
#   "demo_site": {"username": "账号2", "password": "密码2"}
# }
AUTO_USERNAME=
AUTO_PASSWORD=

# ===== 运行参数 =====
HEADLESS=false
CAPTURE_SCREENSHOTS=true
MAX_STEPS=30
HISTORY_STEPS=6
